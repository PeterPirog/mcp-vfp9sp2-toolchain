{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-vfp9sp2-toolchain.dev/schemas/acquisition-manifest.schema.json",
  "title": "Machine-readable external-source acquisition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sot_revision",
    "sot_sha256",
    "generator",
    "content_sha256",
    "artifact_kind",
    "declared_architecture_baseline",
    "acquired_for_current_gate",
    "policy"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "sot_revision": { "type": "integer" },
    "sot_sha256": { "$ref": "#/$defs/sha256" },
    "generated_at_utc": { "type": "string" },
    "content_sha256": { "$ref": "#/$defs/sha256" },
    "generator": { "$ref": "#/$defs/generator" },
    "artifact_kind": { "const": "ACQUISITION_MANIFEST" },
    "declared_architecture_baseline": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/declaration" }
    },
    "acquired_for_current_gate": {
      "type": "array",
      "items": { "$ref": "#/$defs/acquired" }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connected_preparation", "offline_preparation", "runtime_requests", "post_acquisition_fingerprint"],
      "properties": {
        "connected_preparation": { "type": "string" },
        "offline_preparation": { "type": "string" },
        "runtime_requests": { "type": "string" },
        "post_acquisition_fingerprint": { "type": "string" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "version", "source_sha256"],
      "properties": {
        "identity": { "type": "string" },
        "version": { "type": "string" },
        "source_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acquisition_id",
        "role",
        "origin",
        "immutable_identity",
        "allowed_acquisition_modes",
        "license_expectation",
        "destination_role",
        "availability_milestone",
        "acquired_for_current_gate"
      ],
      "properties": {
        "acquisition_id": { "type": "string" },
        "role": { "type": "string" },
        "origin": { "type": "string" },
        "immutable_identity": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": { "type": ["string", "null"] },
          "properties": {
            "kind": { "type": "string" },
            "value": { "type": ["string", "null"] },
            "commit": { "type": ["string", "null"] },
            "tree": { "type": ["string", "null"] }
          }
        },
        "declared_version": { "type": ["string", "null"] },
        "allowed_acquisition_modes": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["BOUND_TOOL_ROOT", "CONNECTED_PINNED", "OFFLINE_CACHE", "OPERATOR_PROVIDED_TRUSTED_HOST"] }
        },
        "license_expectation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {
            "declared": { "type": ["string", "null"] },
            "policy": { "type": "string" }
          }
        },
        "destination_role": { "type": "string" },
        "availability_milestone": { "type": "string" },
        "acquired_for_current_gate": { "type": "boolean", "const": false }
      }
    },
    "acquired": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acquisition_id", "acquisition_mode", "observed_identity", "content_fingerprint_sha256"],
      "properties": {
        "acquisition_id": { "type": "string" },
        "acquisition_mode": { "enum": ["BOUND_TOOL_ROOT", "CONNECTED_PINNED", "OFFLINE_CACHE", "OPERATOR_PROVIDED_TRUSTED_HOST"] },
        "observed_identity": { "type": "object" },
        "content_fingerprint_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}